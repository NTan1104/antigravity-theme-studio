{
  "name": "antigravity-theme-studio",
  "version": "1.0.0",
  "description": "Custom Dark Glass Live Wallpaper, Boot HUD, Custom Greeting & Task Audio Engine for Antigravity via CDP",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "python scripts/build.py",
    "check": "node --check dist/bundle.js && node --check daemon/server.js",
    "start": "node daemon/server.js",
    "verify": "node scripts/verify_cdp.js",
    "install-win": "powershell -ExecutionPolicy Bypass -File scripts/install-win.ps1",
    "launch": "powershell -ExecutionPolicy Bypass -File scripts/launch-app.ps1",
    "launch-ide": "powershell -ExecutionPolicy Bypass -File scripts/launch-app.ps1 -Ide",
    "launch-vscode": "powershell -ExecutionPolicy Bypass -File scripts/launch-app.ps1 -Vscode",
    "uninstall": "node scripts/uninstall.js"
  }
}
